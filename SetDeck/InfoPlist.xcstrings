    "NSHealthShareUsageDescription" : {
      "comment" : "Permission prompt shown when requesting read access to Health data.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SetDeck reads your workouts, water intake, dietary energy, and active energy from Apple Health to show hydration and energy trends and your workout history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeck lee tus entrenamientos, consumo de agua, energía dietética y energía activa de Apple Health para mostrar tendencias de hidratación y energía y tu historial de entrenamientos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeck lit vos entraînements, votre consommation d'eau, votre énergie alimentaire et votre énergie active dans Apple Santé pour afficher vos tendances d'hydratation et d'énergie ainsi que votre historique d'entraînements."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeckは、水分と活動エネルギーの傾向やワークアウト履歴を表示するために、Appleヘルスケアからワークアウト、水分摂取量、食事エネルギー、活動エネルギーを読み取ります。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Permission prompt shown when requesting write access to Health data.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SetDeck saves the water and calories you log, and the strength-training workouts you record, to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeck guarda en Apple Health el agua y las calorías que registras y los entrenamientos de fuerza que grabas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeck enregistre dans Apple Santé l'eau et les calories que vous consignez ainsi que les entraînements de musculation que vous enregistrez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SetDeckは、記録した水分とカロリー、および筋力トレーニングのワークアウトをAppleヘルスケアに保存します。"
          }
        }
      }
    },
    "NSSiriUsageDescription" : {
      "comment" : "Permission prompt shown when requesting Siri access.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SetDeck uses Siri to let you check your workout schedule and control workout sessions with your voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SetDeck usa Siri para que puedas consultar tu plan de entrenamiento y controlar tus sesiones con la voz."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SetDeck utilise Siri pour vous permettre de consulter votre programme d'entraînement et de contrôler vos séances à la voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "SetDeckはSiriを使って、ワークアウトの予定を確認したり、音声でワークアウトを操作したりできます。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
