    "Logs your next set at its target weight and reps and starts the rest timer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs your next set at its target weight and reps and starts the rest timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu siguiente serie con el peso y las repeticiones objetivo e inicia el temporizador de descanso."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ta prochaine série avec le poids et les répétitions visés et lance le minuteur de repos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のセットを目標の重量と回数で記録し、休憩タイマーを開始します。"
          }
        }
      }
    },
    "No set to log. Start a workout in SetDeck first.": {
      "extractionState": "manual",
